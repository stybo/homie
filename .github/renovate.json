{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:recommended", ":dependencyDashboard", ":semanticCommits"],
	"schedule": ["before 5am on monday"],
	"timezone": "Europe/Amsterdam",
	"commitMessagePrefix": "chore(deps):",
	"commitMessageAction": "Bump",
	"rangeStrategy": "bump",
	"labels": ["dependencies"],
	"packageRules": [
		{
			"description": "Group all non-major dependencies together",
			"matchUpdateTypes": ["minor", "patch"],
			"groupName": "all non-major dependencies",
			"groupSlug": "all-minor-patch",
			"commitMessageTopic": "Deps"
		},
		{
			"description": "Group TanStack packages together",
			"matchPackagePrefixes": ["@tanstack/"],
			"groupName": "TanStack packages"
		},
		{
			"description": "Group HeroUI packages together",
			"matchPackagePrefixes": ["@heroui/", "@heroui-pro/"],
			"groupName": "HeroUI packages"
		},
		{
			"description": "Keep Vite+ catalog dependencies in sync",
			"matchPackageNames": ["vite-plus", "@voidzero-dev/vite-plus-core"],
			"groupName": "Vite+ toolchain"
		}
	],
	"lockFileMaintenance": {
		"enabled": true,
		"schedule": ["before 5am on monday"]
	}
}
